APP_ENV=local
APP_PORT=8000

POSTGRES_DB=notification_service
POSTGRES_USER=notification
POSTGRES_PASSWORD=notification
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://notification:notification@localhost:5432/notification_service

HTTP_TIMEOUT_SECONDS=5
WORKER_BATCH_SIZE=10
WORKER_POLL_INTERVAL_SECONDS=5
MAX_ATTEMPTS=5
# Optional comma-separated allowlist. Empty means no allowlist is enforced in local MVP.
TARGET_HOST_ALLOWLIST=
